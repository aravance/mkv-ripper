package indexview

import (
	"github.com/aravance/mkv-ripper/drive"
	"github.com/aravance/mkv-ripper/model"
	"github.com/aravance/mkv-ripper/util"
	"github.com/aravance/mkv-ripper/view/layout"
)

templ Show(drivestat drive.DriveStatus, active []*model.Workflow, errored []*model.Workflow, recent []*model.MovieGroup, hasMore bool) {
	@layout.Base("") {
		<a href="/drive">Drive: { string(drivestat) }</a>
		<h4>Active</h4>
		if len(active) == 0 {
			<div>No workflows in progress</div>
		} else {
			<ul>
				for _, w := range active {
					<li>
						<a href={ templ.SafeURL(util.WorkflowUrl(w.DiscId, w.TitleId)) }>
							if w.Name != nil && *w.Name != "" {
								{ *w.Name }
							} else {
								{ w.Label }
							}
						</a>
						: { string(w.Status) }
					</li>
				}
			</ul>
		}
		if len(errored) > 0 {
			<h4>Errors</h4>
			<ul>
				for _, w := range errored {
					<li>
						<a href={ templ.SafeURL(util.WorkflowUrl(w.DiscId, w.TitleId)) }>
							if w.Name != nil && *w.Name != "" {
								{ *w.Name }
							} else {
								{ w.Label }
							}
						</a>
					</li>
				}
			</ul>
		}
		if len(recent) > 0 {
			<h4>Recent</h4>
			@movieList(recent)
			if hasMore {
				<a href="/history">See all history</a>
			}
		}
	}
}

templ movieList(movies []*model.MovieGroup) {
	<div class="list-group">
		for _, mv := range movies {
			@movieCard(mv)
		}
	</div>
}

func primaryMovieUrl(mv *model.MovieGroup) string {
	if mv.ImdbId != nil && *mv.ImdbId != "" {
		return "/movie/" + *mv.ImdbId
	}
	return util.WorkflowUrl(mv.Workflows[0].DiscId, mv.Workflows[0].TitleId)
}

templ movieCard(mv *model.MovieGroup) {
	<a href={ templ.SafeURL(primaryMovieUrl(mv)) } class="list-group-item list-group-item-action p-0 overflow-hidden">
		<div class="d-flex align-items-center overflow-hidden" style="height: 110px;">
			<div class="w-25 d-flex align-items-center">
				if mv.Poster != "" {
					<img src={ mv.Poster } alt="movie poster" class="w-100"/>
				} else {
					<i class="fa-solid fa-film fa-2xl ps-2 mx-auto"></i>
				}
			</div>
			<div class="d-flex w-75 h-100 align-items-center ps-3">
				<div class="d-flex flex-column w-100">
					<span class="fw-medium">{ mv.Name }</span>
					<span class="fw-light" style="font-size: small;">
						<ul class="list-inline m-0">
							<li class="list-inline-item m-0">{ mv.Year }</li>
							for _, wf := range mv.Workflows {
								if wf.Resolution != nil {
									<li class="list-inline-item m-0">
										<span class="badge text-bg-secondary">{ *wf.Resolution }</span>
									</li>
								}
							}
						</ul>
					</span>
				</div>
			</div>
		</div>
	</a>
}
